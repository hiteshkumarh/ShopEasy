# =============================================================================
# ShopEasy — Root Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the repository root:
#      copy .env.example .env     (Windows PowerShell / CMD)
#      cp .env.example .env       (Linux / macOS / Git Bash)
# 2. Fill in all placeholders below before running Docker Compose.
# =============================================================================

# Application Environment Mode (Use 'production' to enforce strict security validations)
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Security & Cryptographic Keys
# (Must be distinct strings with minimum 32 random characters)
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# HMAC Secret for OTP verification (Must NOT equal SECRET_KEY; minimum 32 chars)
OTP_HMAC_SECRET=change-this-to-a-distinct-random-hmac-secret-minimum-32-chars

# -----------------------------------------------------------------------------
# MySQL 8.0 Database Configuration
# In Docker Compose, DB_HOST must be 'mysql' (the service name).
# -----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shopeasy_db
DB_USER=root
DB_SSL_CA=/etc/secrets/isrgrootx1.pem
DB_PASSWORD=replace-with-your-strong-mysql-password

# -----------------------------------------------------------------------------
# Initial Administrator Account Provisioning
# In production mode, ADMIN_PHONE and ADMIN_PASSWORD must be explicitly provided.
# ADMIN_PASSWORD must be at least 12 characters long.
# -----------------------------------------------------------------------------
ADMIN_NAME=System Admin
ADMIN_PHONE=replace-with-admin-mobile-number
ADMIN_PASSWORD=replace-with-a-strong-admin-password-min-12-chars

# -----------------------------------------------------------------------------
# Simulated Services Configuration
# -----------------------------------------------------------------------------
ENABLE_MOCK_PAYMENT=True
DEV_OTP_CODE=123456
