# =============================================================================
# ShopEasy / Arya Global Digital — Canonical Environment Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the repository root:
#      copy .env.example .env     (Windows PowerShell / CMD)
#      cp .env.example .env       (Linux / macOS / Git Bash)
# 2. Fill in all placeholders below before starting the application.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment Mode
# -----------------------------------------------------------------------------
# Options: 'development' or 'production' (enforces strict security validations)
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins (empty for same-origin)
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Security & Cryptographic Keys
# (Must be distinct strings with minimum 32 random characters in production)
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-secure-random-secret-key-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# HMAC Secret for OTP verification (Must NOT equal SECRET_KEY; minimum 32 chars)
OTP_HMAC_SECRET=change-this-to-a-distinct-random-hmac-secret-minimum-32-chars

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8.0 / TiDB Cloud Serverless)
#
# For local MySQL / Docker Compose:
#   DB_HOST=localhost (or 'mysql' in Docker Compose)
#   DB_PORT=3306
#   DB_NAME=shopeasy_db
#   DB_USER=root
#   DB_PASSWORD=replace-with-your-mysql-password
#   DB_SSL_CA=
#
# For TiDB Cloud Serverless:
#   DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
#   DB_PORT=4000
#   DB_NAME=shopeasy_arya
#   DB_USER=xxxx.root
#   DB_PASSWORD=replace-with-tidb-cloud-password
#   DB_SSL_CA=certs/isrgrootx1.pem (or /etc/secrets/isrgrootx1.pem)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopeasy_db
DB_USER=root
DB_PASSWORD=replace-with-your-strong-db-password
DB_SSL_CA=

# Optional: Full database connection URL override (e.g. mysql+pymysql://user:pass@host:port/db)
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Initial Administrator Account Provisioning (Idempotent seed)
# ADMIN_PHONE must be a 10-digit mobile number (e.g. 9876543210).
# ADMIN_PASSWORD must be at least 12 characters long.
# -----------------------------------------------------------------------------
ADMIN_NAME=System Admin
ADMIN_PHONE=replace-with-admin-mobile-number
ADMIN_PASSWORD=replace-with-a-strong-admin-password-min-12-chars

# -----------------------------------------------------------------------------
# Payment & Simulated Services Configuration
# -----------------------------------------------------------------------------
ENABLE_MOCK_PAYMENT=True
# Options: 'simulated' (dev/test) or 'razorpay' (production)
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=True
SIMULATED_PAYMENT_SECRET=change-this-to-a-simulated-payment-secret
# Fixed OTP code for local development only (strictly blocked in production)
DEV_OTP_CODE=123456

# -----------------------------------------------------------------------------
# Fulfilment Recovery Background Worker
# -----------------------------------------------------------------------------
FULFILMENT_RECOVERY_ENABLED=False
FULFILMENT_RECOVERY_INTERVAL_SECONDS=60
FULFILMENT_RECOVERY_BATCH_SIZE=50
