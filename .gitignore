# =============================================================================
# ShopEasy — Root .gitignore
# =============================================================================

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride
._*

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
venv.bak/
env.bak/
*.venv/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.secret
*.pem
*.key

# Application Logs & Databases
*.log
*.sqlite
*.sqlite3

# Local Test & Scratch Artifacts
scratch/
chrome_profile*/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor Specific Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# User Uploaded Media (Preserve directory structure via .gitkeep)
frontend/uploads/*
!frontend/uploads/.gitkeep
