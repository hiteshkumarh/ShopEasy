# Application Environment
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security (Replace with secure random string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_HMAC_SECRET=change-this-to-a-secure-random-hmac-secret-at-least-32-chars

# MySQL 8.0 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopeasy_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Simulated Services Configuration
ENABLE_MOCK_PAYMENT=True
DEV_OTP_CODE=123456

# Initial Administrator Seed Configuration
ADMIN_NAME=System Admin
ADMIN_PHONE=your_admin_phone_number_here
ADMIN_PASSWORD=your_strong_admin_password_here
